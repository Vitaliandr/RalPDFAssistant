POSTGRES_USER=rag
POSTGRES_PASSWORD=rag_pass
POSTGRES_DB=rag

#ключи облачных моделей в .env не нужны: человек вставляет свой прямо в интерфейсе
#(кнопка Ключ рядом с выбором модели), он хранится только в его браузере

#локальная модель Ollama. адрес и модель можно поменять
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
# OLLAMA_MODEL=qwen2.5:7b

# какая модель у Groq, если нужна не та что по умолчанию
# GROQ_MODEL=openai/gpt-oss-120b

# модель эмбеддингов, считается локально. e5-large точнее но тяжёлая (~2.2 ГБ, индексация медленнее)
#для слабых машин можно взять sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBED_MODEL=intfloat/multilingual-e5-large

#с каких хостов пускаем запросы, на своём сервере впиши домен
# ALLOWED_HOSTS=localhost,127.0.0.1

# для запуска api без докера (БД и redis в compose, остальное на хосте)
# DATABASE_URL=postgresql+psycopg://rag:rag_pass@localhost:5432/rag
# REDIS_URL=redis://localhost:6379/0
