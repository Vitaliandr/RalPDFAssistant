POSTGRES_USER=rag
POSTGRES_PASSWORD=rag_pass
POSTGRES_DB=rag

#ключи облаков тут не нужны, свой ключ вставляется в интерфейсе

# ollama, адрес и модель можно менять
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
# OLLAMA_MODEL=qwen2.5:7b

#если нужна другая модель у groq
# GROQ_MODEL=openai/gpt-oss-120b

# эмбеддинги считаются локально, e5 тяжёлая (2.2 ГБ)
#на слабой машине sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBED_MODEL=intfloat/multilingual-e5-large

# с каких хостов пускаем, на сервере свой домен
# ALLOWED_HOSTS=localhost,127.0.0.1

#api без докера, бд и redis из compose
# DATABASE_URL=postgresql+psycopg://rag:rag_pass@localhost:5432/rag
# REDIS_URL=redis://localhost:6379/0
