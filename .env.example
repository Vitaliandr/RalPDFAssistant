POSTGRES_USER=rag
POSTGRES_PASSWORD=rag_pass
POSTGRES_DB=rag

#кто отвечает на вопросы: ollama, groq, gemini или custom
LLM_PROVIDER=ollama
# ключ нужен для groq и gemini, для ollama оставь пустым
LLM_API_KEY=
#модель и адрес можно не трогать, подставятся по умолчанию для провайдера
# LLM_MODEL=
# LLM_BASE_URL=

# модель эмбеддингов, считается локально. e5-large точнее но тяжёлая (~2.2 ГБ, индексация медленнее)
#для слабых машин можно взять sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBED_MODEL=intfloat/multilingual-e5-large

# для запуска api без докера (БД и redis в compose, остальное на хосте)
# DATABASE_URL=postgresql+psycopg://rag:rag_pass@localhost:5432/rag
# REDIS_URL=redis://localhost:6379/0
